# Copy to .env for local use. NEVER commit the real .env file.
GEMINI_API_KEY=your_key_from_aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash
# Local default is SQLite. For deployment use your Neon/Supabase Postgres URL:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./aethermind.db
# After deploying the frontend, set to its URL (comma-separated for several)
ALLOWED_ORIGINS=*
